# Copy to .env and customize (optional).
# The companion reads these from the environment when you start npm.

# --- Local dev (legacy single-device mode) ---
# If set, the server uses one fixed token instead of multi-device pairing.
# ONIONPEEL_TOKEN=change-me-to-a-long-random-string

# Port (default 8787)
# PORT=8787

# --- Cloud deploy (Railway, etc.) ---
# Public HTTPS URL shown to users and phones. Do NOT set ONIONPEEL_TOKEN in production.
# PUBLIC_URL=https://onionpeel-production.up.railway.app

# Persistent data directory (mount a volume at /data on Railway)
# DATA_DIR=/data
